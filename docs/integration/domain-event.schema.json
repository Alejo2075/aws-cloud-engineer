{
  "$id": "https://github.com/Alejo2075/aws-cloud-engineer/docs/integration/domain-event.schema.json",
  "title": "CloudEngineerDomainEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "RunCreated",
        "BlueprintPublished",
        "BuildCompleted",
        "TestsFailed",
        "DeploymentApprovalRequested",
        "DeploymentCompleted",
        "VerificationFailed",
        "SystemHandoffPublished"
      ]
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "CREATED",
        "INTAKE",
        "REQUIREMENTS",
        "DESIGN",
        "PLAN",
        "GENERATE",
        "BUILD",
        "TEST",
        "SECURITY_REVIEW",
        "DEPLOYMENT_REVIEW",
        "AWAITING_APPROVAL",
        "DEPLOY",
        "VERIFY",
        "HANDOFF",
        "SUCCEEDED"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": ["kind", "sha256"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "id", "type", "runId", "correlationId", "at", "stage"],
  "additionalProperties": false
}
